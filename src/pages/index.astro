---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimelineItem from "../components/home/TimelineItem.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog", ({ data }) => data.published);

const sortedPosts = allPosts.sort((a, b) => {
	const dateA = a.data.创建时间?.valueOf() ?? 0;
	const dateB = b.data.创建时间?.valueOf() ?? 0;
	return dateB - dateA;
});

const PAGE_SIZE = 5;
---

<BaseLayout>
	<main class="pt-24 pb-20 max-w-4xl mx-auto px-4 min-h-screen">
		<!-- System Status Header -->
		<header
			class="mb-12 border-b-2 border-eva-ink/10 dark:border-white/10 pb-4"
		>
			<h1 class="text-xs font-mono tracking-widest opacity-60 uppercase">
				System Status: Online
			</h1>
			<p class="text-4xl font-serif font-bold mt-2">Transmissions</p>
		</header>

		<!-- Vertical Timeline -->
		<div
			id="timeline-container"
			class="relative border-l border-eva-ink/20 dark:border-white/20 ml-3 md:ml-6 space-y-12"
			data-page-size={PAGE_SIZE}
			data-total={sortedPosts.length}
		>
			{
				sortedPosts.map((post, index) => (
					<div
						class:list={[
							"timeline-entry",
							index >= PAGE_SIZE && "hidden",
						]}
						data-index={index}
					>
						<TimelineItem post={post} />
					</div>
				))
			}
		</div>

		<!-- Load More / End Indicator -->
		<div
			id="timeline-footer"
			class="mt-12 ml-3 md:ml-6 pl-8 md:pl-12 border-l border-dashed border-eva-ink/20 dark:border-white/20"
		>
			{
				sortedPosts.length > PAGE_SIZE ? (
					<button
						id="load-more-btn"
						class="text-sm font-mono opacity-50 hover:text-eva-purple hover:opacity-100 transition-all uppercase tracking-wider cursor-pointer"
					>
						[ Load More Data ]
					</button>
				) : (
					<span class="text-sm font-mono opacity-50 uppercase tracking-wider">
						[ END OF TRANSMISSIONS ]
					</span>
				)
			}
		</div>

		<!-- Scroll Sentinel (for auto-load on scroll) -->
		<div id="scroll-sentinel" class="h-1"></div>

		<!-- Empty State -->
		{
			sortedPosts.length === 0 && (
				<div class="text-center py-20 opacity-50 font-mono text-sm">
					NO TRANSMISSIONS FOUND
				</div>
			)
		}
	</main>
</BaseLayout>

<script>
	function initTimeline() {
		const container = document.getElementById("timeline-container");
		const loadMoreBtn = document.getElementById("load-more-btn");
		const sentinel = document.getElementById("scroll-sentinel");
		const footer = document.getElementById("timeline-footer");

		if (!container) return;

		const pageSize = parseInt(container.dataset.pageSize ?? "5", 10);
		const total = parseInt(container.dataset.total ?? "0", 10);
		let visibleCount = Math.min(pageSize, total);

		function loadMore() {
			const entries = container!.querySelectorAll(
				".timeline-entry.hidden",
			);
			const toShow = Array.from(entries).slice(0, pageSize);

			toShow.forEach((entry, i) => {
				entry.classList.remove("hidden");
				// 渐入动画
				const el = entry as HTMLElement;
				el.style.opacity = "0";
				el.style.transform = "translateY(20px)";
				setTimeout(() => {
					el.style.transition = "all 0.4s ease-out";
					el.style.opacity = "1";
					el.style.transform = "translateY(0)";
				}, i * 80);
			});

			visibleCount += toShow.length;

			// 全部加载完毕
			if (visibleCount >= total && footer) {
				footer.innerHTML = `
                    <span class="text-sm font-mono opacity-50 uppercase tracking-wider">
                        [ END OF TRANSMISSIONS ]
                    </span>
                `;
			}
		}

		// 按钮点击加载
		loadMoreBtn?.addEventListener("click", loadMore);

		// IntersectionObserver 自动加载
		if (sentinel && "IntersectionObserver" in window) {
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting && visibleCount < total) {
							loadMore();
						}
					});
				},
				{ rootMargin: "200px" },
			);
			observer.observe(sentinel);
		}
	}

	initTimeline();
	document.addEventListener("astro:after-swap", initTimeline);
</script>
