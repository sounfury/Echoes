---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimelineItem from "../components/home/TimelineItem.astro";
import { getCollection } from "astro:content";
import { getSiteConfig } from "../lib/config";

const allPosts = await getCollection("blog", ({ data }) => data.published);

const sortedPosts = allPosts.sort((a, b) => {
	const dateA = a.data.创建时间?.valueOf() ?? 0;
	const dateB = b.data.创建时间?.valueOf() ?? 0;
	return dateB - dateA;
});

const PAGE_SIZE = getSiteConfig().timeline.pageSize;
---

<BaseLayout page="home">
	<main data-ui="main" class="pt-24 pb-20 min-h-screen">
		<!-- System Status Header -->
		<header
			data-ui="page-header"
			class="mb-12 border-b-2 border-ink/10 pb-4"
		>
			<h1
				data-ui="page-kicker"
				data-copy
				data-ui-default="System Status: Online"
				class="text-xs font-mono tracking-widest opacity-60 uppercase"
			>System Status: Online</h1>
			<p
				data-ui="page-title"
				data-copy
				data-ui-default="Transmissions"
				class="text-4xl font-serif font-bold mt-2"
			>Transmissions</p>
		</header>

		<!-- Vertical Timeline -->
		<div
			id="timeline-container"
			data-ui="timeline"
			class="relative border-l border-ink/20 ml-3 md:ml-6 space-y-12"
			data-page-size={PAGE_SIZE}
			data-total={sortedPosts.length}
		>
			{
				sortedPosts.map((post, index) => (
					<div
						class:list={[
							"timeline-entry",
							index >= PAGE_SIZE && "hidden",
						]}
						data-index={index}
					>
						<TimelineItem post={post} />
					</div>
				))
			}
		</div>

		<!-- Load More / End Indicator -->
		<div
			id="timeline-footer"
			data-ui="timeline-footer"
			class="mt-12 ml-3 md:ml-6 pl-8 md:pl-12 border-l border-dashed border-ink/20"
		>
			{
				sortedPosts.length > PAGE_SIZE ? (
					<button
						id="load-more-btn"
						data-ui="load-more"
						class="text-sm font-mono opacity-50 hover:text-accent hover:opacity-100 transition-all uppercase tracking-wider cursor-pointer"
					>
						[ Load More Data ]
					</button>
				) : (
					<span data-ui="timeline-end" class="text-sm font-mono opacity-50 uppercase tracking-wider">
						[ END OF TRANSMISSIONS ]
					</span>
				)
			}
		</div>

		<!-- Scroll Sentinel (for auto-load on scroll) -->
		<div id="scroll-sentinel" class="h-1"></div>

		<!-- Empty State -->
		{
			sortedPosts.length === 0 && (
				<div data-ui="empty-state" class="text-center py-20 opacity-50 font-mono text-sm">
					NO TRANSMISSIONS FOUND
				</div>
			)
		}
	</main>
</BaseLayout>

<script>
	/**
	 * 初始化 Timeline
	 */
	import { initTimeline } from "../lib/client/timeline";

	type TimelineRuntime = {
		mount: () => void;
	};

	const win = window as Window & {
		__echoesTimelineRuntime?: TimelineRuntime;
	};

	if (!win.__echoesTimelineRuntime) {
		let destroyTimeline = () => {};

		const mount = () => {
			destroyTimeline();
			destroyTimeline = () => {};

			const isHomePage =
				window.location.pathname === "/" || window.location.pathname === "";
			if (!isHomePage) return;

			destroyTimeline = initTimeline();
		};

		const onPageLoad = () => mount();
		const onBeforeSwap = () => {
			destroyTimeline();
			destroyTimeline = () => {};
		};

		document.addEventListener("astro:page-load", onPageLoad);
		document.addEventListener("astro:before-swap", onBeforeSwap);

		win.__echoesTimelineRuntime = { mount };
	}

	win.__echoesTimelineRuntime?.mount();
</script>
