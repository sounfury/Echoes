---
import { SEO } from "astro-seo";
import { getSiteConfig } from "../lib/config";
import "../styles/global.css";

const config = getSiteConfig();
const title = `404 // 信号丢失 — ${config.site.title}`;
const description =
    "如同坠入深海的石子，你的请求没有激起任何涟漪。请确认记忆的路径是否发生了偏移。";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { colors, defaultMode: defaultThemeMode } = config.theme;
const { accent, terminal, warning, light, dark: darkColors } = colors;
---

<!doctype html>
<html
    lang="zh-CN"
    style={`--cfg-accent:${accent};--cfg-terminal:${terminal};--cfg-warning:${warning};--cfg-bg-light:${light.bg};--cfg-bg-secondary-light:${light.bgSecondary};--cfg-text-light:${light.text};--cfg-text-secondary-light:${light.textSecondary};--cfg-border-light:${light.border};--cfg-bg-dark:${darkColors.bg};--cfg-bg-secondary-dark:${darkColors.bgSecondary};--cfg-text-dark:${darkColors.text};--cfg-text-secondary-dark:${darkColors.textSecondary};--cfg-border-dark:${darkColors.border}`}
>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Noto+Serif+SC:wght@400;700;900&display=swap"
            rel="stylesheet"
        />

        <SEO
            title={title}
            description={description}
            canonical={canonicalURL.href}
            noindex={true}
            nofollow={true}
        />

        <script is:inline define:vars={{ defaultThemeMode }}>
            (function () {
                // 与主题运行时共用存储（src/lib/themes/client/runtime.ts）；兼容旧的 theme-mode
                var stored = null;
                try {
                    stored = (JSON.parse(localStorage.getItem("echoes:theme") || "{}") || {}).mode || localStorage.getItem("theme-mode");
                } catch (e) {}
                var isDark = (stored || defaultThemeMode) === "dark";
                document.documentElement.classList.toggle("dark", isDark);
            })();
        </script>
    </head>
    <body
        class="transition-colors duration-500 min-h-screen relative overflow-hidden flex items-center justify-center font-sans"
    >
        <!-- Blurred Atmosphere Orbs -->
        <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
            <div
                class="absolute top-1/4 left-1/4 w-[40vw] h-[40vw] bg-eva-purple/20 rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-[100px] animate-[pulse_8s_cubic-bezier(0.4,0,0.6,1)_infinite]"
            >
            </div>
            <div
                class="absolute bottom-1/4 right-1/4 w-[30vw] h-[30vw] bg-black/5 dark:bg-white/5 rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-[80px] animate-[pulse_8s_cubic-bezier(0.4,0,0.6,1)_infinite]"
                style="animation-delay: -4s"
            >
            </div>
        </div>

        <!-- Frosted Glass Card -->
        <div
            class="z-10 relative max-w-lg w-full px-6 flex flex-col items-center"
        >
            <!-- Abstract Missing Graphic -->
            <div
                id="eye-container"
                class="w-24 h-24 mb-12 relative flex items-center justify-center transition-transform duration-75 ease-out"
            >
                <div
                    class="absolute inset-0 border border-black/20 dark:border-white/20 rounded-full animate-[spin_10s_linear_infinite]"
                >
                </div>
                <div
                    class="absolute inset-2 border border-black/10 dark:border-white/10 rounded-full animate-[spin_15s_linear_infinite_reverse]"
                >
                </div>
                <div
                    class="eye-dot w-1 h-1 bg-black dark:bg-white rounded-full shadow-[0_0_10px_rgba(0,0,0,0.5)] dark:shadow-[0_0_10px_rgba(255,255,255,0.8)] transition-transform duration-75 ease-out"
                >
                </div>
            </div>

            <h1
                class="text-3xl font-serif font-light tracking-widest mb-6 opacity-90 text-center"
            >
                信 号 <span
                    class="text-eva-purple font-serif ml-1 opacity-70 italic"
                    >丢失</span
                >
            </h1>

            <p
                class="text-sm opacity-50 text-center leading-relaxed font-light mb-12 max-w-sm"
            >
                如同坠入深海的石子，你的请求没有激起任何涟漪。请确认记忆的路径是否发生了偏移。
            </p>

            <a
                href="/"
                class="relative overflow-hidden group border border-black/20 dark:border-white/20 py-3 px-8 rounded-full bg-black/5 dark:bg-white/5 backdrop-blur-md hover:border-eva-purple dark:hover:border-eva-purple transition-colors duration-500"
            >
                <span
                    class="relative z-10 text-xs font-mono tracking-[0.2em] group-hover:text-eva-purple transition-colors"
                >
                    重新浮出水面
                </span>
                <div
                    class="absolute inset-0 bg-gradient-to-r from-transparent via-black/5 dark:via-white/5 to-transparent transform -translate-x-full group-hover:translate-x-full transition-transform duration-1000"
                >
                </div>
            </a>
        </div>

        <!-- Eye Tracking Script -->
        <script is:inline>
            document.addEventListener("DOMContentLoaded", () => {
                const eyeContainer = document.getElementById("eye-container");
                const eyeDot = eyeContainer?.querySelector(".eye-dot");

                if (!eyeContainer || !eyeDot) return;

                let ticking = false;
                let mouseX = 0;
                let mouseY = 0;

                document.addEventListener("mousemove", (e) => {
                    mouseX = e.clientX;
                    mouseY = e.clientY;
                    if (!ticking) {
                        requestAnimationFrame(() => {
                            const rect = eyeContainer.getBoundingClientRect();
                            const centerX = rect.left + rect.width / 2;
                            const centerY = rect.top + rect.height / 2;

                            // 计算鼠标相对于圆心的偏移
                            const deltaX = mouseX - centerX;
                            const deltaY = mouseY - centerY;

                            // 限制最大移动距离，产生像眼球在眼眶内转动的效果
                            const distance = Math.sqrt(
                                deltaX * deltaX + deltaY * deltaY,
                            );
                            const maxRadius = 15;
                            const factor =
                                Math.min(distance, maxRadius) / (distance || 1);

                            const mappedX = deltaX * factor;
                            const mappedY = deltaY * factor;

                            // 光点移动幅度稍大
                            eyeDot.style.transform = `translate(${mappedX}px, ${mappedY}px)`;
                            // 整个外层容器做视差极小幅移动
                            eyeContainer.style.transform = `translate(${mappedX * 0.2}px, ${mappedY * 0.2}px)`;

                            ticking = false;
                        });
                        ticking = true;
                    }
                });
            });
        </script>
    </body>
</html>
