---
import { ClientRouter } from "astro:transitions";
import { SEO } from "astro-seo";
import { getDefaultPlayerSource, getSiteConfig } from "../lib/config";
import Header from "../components/common/Header.astro";
import GlobalPlayer from "../components/player/GlobalPlayer";
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
}

const config = getSiteConfig();
const { title = config.site.title, description = config.site.description } =
    Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const playerSource = getDefaultPlayerSource(config);

const { colors, defaultMode: defaultThemeMode } = config.theme;
const { accent, terminal, warning, light, dark: darkColors } = colors;

const ogImage = `${config.site.url}/covers/og-default.jpg`;
---

<!doctype html>
<html
    lang="zh-CN"
    class="scroll-smooth"
    style={`--c-accent:${accent};--c-terminal:${terminal};--c-warning:${warning};--c-bg-light:${light.bg};--c-bg-secondary-light:${light.bgSecondary};--c-text-light:${light.text};--c-text-secondary-light:${light.textSecondary};--c-border-light:${light.border};--c-bg-dark:${darkColors.bg};--c-bg-secondary-dark:${darkColors.bgSecondary};--c-text-dark:${darkColors.text};--c-text-secondary-dark:${darkColors.textSecondary};--c-border-dark:${darkColors.border}`}
>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Noto+Serif+SC:wght@400;700;900&display=swap"
            rel="stylesheet"
        />

        <SEO
            title={title}
            description={description}
            canonical={canonicalURL.href}
            openGraph={{
                basic: {
                    title: title,
                    type: "website",
                    url: canonicalURL.href,
                    image: ogImage,
                },
                optional: {
                    description: description,
                    siteName: config.site.title,
                    locale: "zh_CN",
                },
            }}
            twitter={{
                card: "summary_large_image",
                title: title,
                description: description,
                image: ogImage,
            }}
        />

        <ClientRouter />

        <!-- Theme Init (FOUC prevention) -->
        <script is:inline define:vars={{ defaultThemeMode }}>
            (function () {
                var stored = localStorage.getItem("theme-mode");
                var isDark = (stored || defaultThemeMode) === "dark";
                document.documentElement.classList.toggle("dark", isDark);
            })();
        </script>
    </head>
    <body
        class="transition-colors duration-500 min-h-screen relative overflow-x-hidden font-sans"
    >
        <!-- Background Layers -->
        <div
            class="fixed inset-0 -z-10 bg-grid-pattern opacity-50 pointer-events-none"
        >
        </div>

        <!-- Decorative EVA Side Text -->
        <div
            class="fixed top-20 left-4 text-[10px] font-mono opacity-30 rotate-90 hidden lg:block tracking-widest"
        >
            SYSTEM_STATUS: NORMAL // SYNC_RATE: 100%
        </div>

        <!-- Global Navigation -->
        <Header />

        <!-- Page Content -->
        <slot />

        <!-- Global Music Player -->
        {
            config.bgm.enabled && playerSource && (
                <div id="global-player-shell" transition:persist>
                    <GlobalPlayer source={playerSource} client:only="react" />
                </div>
            )
        }
    </body>
</html>
