---
import { ClientRouter } from "astro:transitions";
import { SEO } from "astro-seo";
import { getSiteConfig } from "../lib/config";
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
}

const config = getSiteConfig();
const { title = config.site.title, description = config.site.subtitle } =
    Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+SC:wght@400;700&display=swap"
            rel="stylesheet"
        />

        <SEO
            title={title}
            description={description}
            canonical={canonicalURL.href}
            openGraph={{
                basic: {
                    title: title,
                    type: "website",
                    url: canonicalURL.href,
                    image: "",
                },
            }}
        />

        <ClientRouter />

        <!-- Theme Init (避免 FOUC) -->
        <script is:inline>
            (function () {
                const stored = localStorage.getItem("theme-mode");
                const mode = stored || "system";
                const dark =
                    mode === "dark" ||
                    (mode === "system" &&
                        window.matchMedia("(prefers-color-scheme: dark)")
                            .matches);
                document.documentElement.classList.toggle("dark", dark);
            })();
        </script>
    </head>
    <body>
        <slot />
    </body>
</html>
