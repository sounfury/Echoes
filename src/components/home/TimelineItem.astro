---
import type { CollectionEntry } from "astro:content";
import {
    getCategoryFromId,
    getCategoryMeta,
    getTitleFromId,
    formatDateShort,
    getExcerpt,
} from "../../lib/utils";

interface Props {
    post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const category = getCategoryFromId(post.id);
const categoryMeta = getCategoryMeta(category);
const title = getTitleFromId(post.id);
const color = categoryMeta.color;
const cover = post.data.封面图;

const createDate = post.data.创建时间;
const updateDate = post.data.更新时间;
const isUpdated = !!(
    updateDate &&
    createDate &&
    updateDate.getTime() !== createDate.getTime()
);
const fullDate = createDate
    ? `${createDate.getFullYear()}.${formatDateShort(createDate)}`
    : "";
const tags = post.data.tags;

const excerpt = getExcerpt(post.body ?? "");
---

<article
    class:list={[
        "timeline-item relative pl-8 md:pl-12 group cursor-pointer",
        cover && "has-cover",
    ]}
    style={`--item-color: ${color};`}
>
    {
        cover && (
            <div class="cover-wipe" aria-hidden="true">
                <img
                    src={cover}
                    alt=""
                    onerror="this.parentElement.hidden = true"
                />
                <span class="cover-wipe-scrim"></span>
            </div>
        )
    }
    <a href={`/posts/${post.id}`} class="no-underline block relative z-[1]">
        <!-- Node Circle -->
        <span
            class="absolute -left-[9px] top-1 w-4 h-4 rounded-full border-2 transition-colors z-10 bg-eva-paper dark:bg-eva-dark"
            style={`border-color: ${color};`}
            data-node></span>

        <!-- Date Label (desktop: absolute left, mobile: inline) -->
        <div
            class="md:absolute md:-left-32 md:top-1 md:text-right w-24 mb-1 md:mb-0"
        >
            <span
                class="font-mono text-sm opacity-60 group-hover:opacity-100 group-hover:text-[var(--item-color)] transition-all"
            >
                {fullDate}{isUpdated && " ↻"}
            </span>
        </div>

        <!-- Content -->
        <div>
            <!-- Category & ID Badge -->
            <div class="flex items-center gap-2 mb-2">
                <span
                    class="text-[10px] font-mono px-1 py-0.5 text-white"
                    style={`background-color: ${color};`}
                >
                    {categoryMeta.label}
                </span>
            </div>

            <!-- Title -->
            <h2
                class="text-2xl md:text-3xl font-serif font-bold mb-3 transition-colors group-hover:text-[var(--item-color)]"
            >
                {title}
            </h2>

            <!-- Excerpt -->
            {
                excerpt && (
                    <p class="text-sm md:text-base opacity-70 leading-relaxed font-sans line-clamp-2">
                        {excerpt}
                    </p>
                )
            }

            <!-- Tags -->
            {
                tags.length > 0 && (
                    <div class="flex gap-2 mt-3">
                        {tags.map((tag: string) => (
                            <span class="text-[10px] font-mono opacity-40 uppercase">
                                #{tag}
                            </span>
                        ))}
                    </div>
                )
            }
        </div>
    </a>
</article>

<style>
    .timeline-item:hover [data-node] {
        background-color: var(--item-color) !important;
    }

    .cover-wipe {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 2rem;
        z-index: 2;
        pointer-events: none;
        clip-path: inset(0 0 0 100%);
        transition: clip-path 0.5s ease-out;
    }

    @media (min-width: 768px) {
        .cover-wipe {
            left: 3rem;
        }
    }

    .cover-wipe img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: saturate(0.85);
    }

    .cover-wipe-scrim {
        position: absolute;
        inset: 0;
        background: color-mix(in srgb, var(--c-bg) 28%, transparent);
    }

    @media (hover: hover) {
        .timeline-item.has-cover:hover .cover-wipe,
        .timeline-item.has-cover:focus-within .cover-wipe {
            clip-path: inset(0 0 0 0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .cover-wipe {
            transition: none;
        }
    }
</style>
