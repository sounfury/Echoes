---
import type { CollectionEntry } from "astro:content";
import {
    getCategoryFromId,
    getCategoryMeta,
    getTitleFromId,
    formatDateShort,
    getExcerpt,
} from "../../lib/utils";

interface Props {
    post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const category = getCategoryFromId(post.id);
const categoryMeta = getCategoryMeta(category);
const title = getTitleFromId(post.id);
const color = categoryMeta.color;
const cover = post.data.封面图;

const createDate = post.data.创建时间;
const updateDate = post.data.更新时间;
const isUpdated = !!(
    updateDate &&
    createDate &&
    updateDate.getTime() !== createDate.getTime()
);
const fullDate = createDate
    ? `${createDate.getFullYear()}.${formatDateShort(createDate)}`
    : "";
const tags = post.data.tags;

const excerpt = getExcerpt(post.body ?? "");
---

<article
    data-ui="timeline-item"
    data-category={category}
    class="timeline-item relative pl-8 md:pl-12 group cursor-pointer"
    style={`--item-color: ${color};`}
>
    <!-- Node Circle (精确吸附在时间轴竖线上) -->
    <span
        data-ui="timeline-node"
        class="absolute left-0 -translate-x-1/2 top-1.5 w-4 h-4 rounded-full border-2 transition-all duration-300 z-20 bg-canvas group-hover:bg-[var(--item-color)] group-hover:scale-125"
        style={`border-color: ${color};`}
        data-node></span>

    <!-- Date Label (桌面端绝对定位在时间轴左侧，防止换行) -->
    <div
        data-ui="timeline-date"
        class="hidden md:block md:absolute md:-left-36 md:top-1 md:text-right w-28 whitespace-nowrap"
    >
        <span
            data-ui="post-date"
            class="font-mono text-sm opacity-60 group-hover:opacity-100 group-hover:text-[var(--item-color)] transition-colors duration-300"
        >
            {fullDate}{isUpdated && " ↻"}
        </span>
    </div>

    <!-- Article Content Link (纯净极简排版，无封闭边框方块) -->
    <a href={`/posts/${post.id}`} data-ui="post-card" class="no-underline block relative">
        <!-- Cover Wipe Effect (完全覆盖文章整体区域) -->
        {
            cover && (
                <div data-ui="card-cover" class="cover-wipe absolute -inset-y-3 -inset-x-3 md:-inset-x-4 z-0 pointer-events-none overflow-hidden rounded-xs" aria-hidden="true">
                    <img
                        src={cover}
                        alt=""
                        class="w-full h-full object-cover object-center transform scale-100 group-hover:scale-105 transition-transform duration-1000 ease-out"
                        onerror="this.closest('.cover-wipe')?.remove()"
                    />
                    <span data-ui="card-cover-scrim" class="cover-wipe-scrim absolute inset-0"></span>
                </div>
            )
        }

        <!-- Content -->
        <div data-ui="card-body" class="relative z-[1]">
            <!-- Mobile Date -->
            <div data-ui="card-date" class="md:hidden font-mono text-xs opacity-60 mb-2">
                {fullDate}{isUpdated && " ↻"}
            </div>

            <!-- Category & ID Badge -->
            <div class="flex items-center gap-2 mb-2">
                <span
                    data-ui="category-badge"
                    class="text-[10px] font-mono px-1 py-0.5 text-on-accent"
                    style={`background-color: ${color};`}
                >
                    {categoryMeta.label}
                </span>
            </div>

            <!-- Title -->
            <h2
                data-ui="post-card-title"
                class="text-2xl md:text-3xl font-serif font-bold mb-3 transition-colors duration-300 group-hover:text-[var(--item-color)]"
            >
                {title}
            </h2>

            <!-- Excerpt -->
            {
                excerpt && (
                    <p data-ui="post-card-excerpt" class="text-sm md:text-base opacity-70 leading-relaxed font-sans line-clamp-2">
                        {excerpt}
                    </p>
                )
            }

            <!-- Tags -->
            {
                tags.length > 0 && (
                    <div data-ui="tag-list" class="flex flex-wrap gap-2 mt-3">
                        {tags.map((tag: string) => (
                            <span data-ui="tag" class="text-[10px] font-mono opacity-40 uppercase">
                                #{tag}
                            </span>
                        ))}
                    </div>
                )
            }
        </div>
    </a>
</article>

<style>
    /* 组件样式放在 components 层，主题的 @layer skin 可以覆盖（见 src/themes/_contract.md） */
    @layer components {
        .timeline-item:hover [data-node],
        .timeline-item:hover [data-ui="timeline-node"] {
            box-shadow: 0 0 10px var(--item-color);
        }

        .cover-wipe {
            clip-path: inset(0 0 0 100%);
            transition: clip-path 0.85s cubic-bezier(0.22, 1, 0.36, 1);
        }

        /* 图片绝对定位铺满封面框：高度不依赖百分比高度的解析，封面只会占据本条目卡片（四周各外扩 0.75rem） */
        .cover-wipe img {
            position: absolute;
            inset: 0;
            filter: saturate(0.95);
            opacity: 0.92;
        }

        /* 封面遮罩从页面底色渐隐（暗色下与原先的 rgba(10,10,12,…) 等值，底色来自 --c-bg） */
        .cover-wipe-scrim {
            background: linear-gradient(
                to right,
                color-mix(in srgb, var(--c-bg) 85%, transparent) 0%,
                color-mix(in srgb, var(--c-bg) 60%, transparent) 40%,
                color-mix(in srgb, var(--c-bg) 20%, transparent) 75%,
                transparent 100%
            );
        }

        :global(:root[data-mode="dark"]) .cover-wipe img {
            filter: saturate(1.05);
            opacity: 0.88;
        }

        :global(:root[data-mode="dark"]) .cover-wipe-scrim {
            background: linear-gradient(
                to right,
                color-mix(in srgb, var(--c-bg) 82%, transparent) 0%,
                color-mix(in srgb, var(--c-bg) 55%, transparent) 35%,
                color-mix(in srgb, var(--c-bg) 18%, transparent) 70%,
                transparent 100%
            );
        }

        @media (hover: hover) {
            .timeline-item:hover .cover-wipe,
            .timeline-item:focus-within .cover-wipe {
                clip-path: inset(0 0 0 0);
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .cover-wipe {
                transition: none;
            }
        }
    }
</style>
