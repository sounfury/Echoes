---
import { getSiteConfig } from "../../lib/config";
import { Image } from "astro:assets";
import siteIcon from "../../assets/icon/icon.jpg";
import { themes } from "../../lib/themes/registry";

const config = getSiteConfig();
const navItems = config.navigation;
const currentPath = Astro.url.pathname;
---

<style>
    @layer components {
        #site-subtitle::after {
            content: "|";
            margin-left: 0.125rem;
            color: var(--c-caret);
            font-weight: 700;
            animation: cursor-blink 1s step-end infinite;
        }
    }

    @keyframes cursor-blink {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0;
        }
    }
</style>

<nav
    data-ui="header"
    class="fixed top-0 w-full z-50 border-b-2 border-ink/10 backdrop-blur-md  transition-all duration-300"
>
    <div
        data-ui="header-inner"
        class="h-16 flex items-center justify-between"
    >
        <!-- Logo -->
        <a
            href="/"
            data-ui="brand"
            class="flex items-center gap-3 cursor-pointer group no-underline"
        >
            <div
                data-ui="brand-logo"
                class="w-8 h-8 bg-ink text-on-ink flex items-center justify-center font-bold font-mono text-xs group-hover:bg-accent group-hover:text-on-accent transition-colors overflow-hidden rounded-sm"
            >
                <Image
                    src={siteIcon}
                    alt="Logo"
                    class="w-full h-full object-cover"
                />
            </div>
            <div class="flex flex-col">
                <span
                    data-ui="brand-title"
                    data-copy
                    data-ui-default={config.site.logoText}
                    class="font-black tracking-tighter text-lg leading-none font-sans uppercase"
                >
                    {config.site.logoText}
                </span>
                <span
                    id="site-subtitle"
                    data-ui="brand-subtitle"
                    data-copy
                    data-ui-default={config.site.subtitle}
                    class="text-[9px] font-mono tracking-[0.2em] opacity-60 inline-flex items-center"
                    data-text={config.site.subtitle}
                >
                    {config.site.subtitle}
                </span>
            </div>
        </a>

        <!-- Menu -->
        <div class="flex items-center gap-6">
            <!-- Desktop Nav Links -->
            <div
                data-ui="nav"
                class="hidden md:flex gap-6 font-mono text-xs tracking-widest font-bold"
            >
                {
                    navItems.map((item) => {
                        const isActive =
                            item.path === currentPath ||
                            (item.path === "/" && currentPath === "/");
                        const isExternal = item.external;
                        return (
                            <a
                                href={item.path}
                                data-ui="nav-link"
                                data-state={isActive ? "active" : undefined}
                                aria-current={isActive ? "page" : undefined}
                                class:list={[
                                    "transition-colors relative group",
                                    isActive
                                        ? "text-accent"
                                        : "hover:text-accent",
                                ]}
                                target={isExternal ? "_blank" : undefined}
                                rel={
                                    isExternal
                                        ? "noopener noreferrer"
                                        : undefined
                                }
                            >
                                {item.name.toUpperCase()}
                                <span
                                    class:list={[
                                        "absolute -bottom-1 left-0 h-[2px] bg-accent transition-all",
                                        isActive
                                            ? "w-full"
                                            : "w-0 group-hover:w-full",
                                    ]}
                                />
                            </a>
                        );
                    })
                }
            </div>

            <!-- Search Icon -->
            <a
                href="/archive"
                data-ui="search-link"
                class="hover:text-accent transition-colors"
                aria-label="Search"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </a>

            <!-- Theme Switcher: 主题包选择 + 明暗模式 -->
            <div data-ui="theme-switcher" class="relative flex items-center gap-2">
                {
                    themes.length > 1 && (
                        <button
                            id="theme-menu-toggle"
                            data-ui="theme-menu-toggle"
                            class="w-8 h-8 flex items-center justify-center border border-current hover:bg-ink hover:text-on-ink transition-all rounded-sm cursor-pointer"
                            aria-label="Choose theme"
                            aria-haspopup="menu"
                            aria-expanded="false"
                            aria-controls="theme-menu"
                        >
                            <svg
                                class="w-4 h-4"
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path d="M12 22a10 10 0 1 1 10-10c0 2.8-2.2 4-4 4h-1.6a1.6 1.6 0 0 0-1.2 2.7 1.6 1.6 0 0 1-1.2 2.7z" />
                                <circle cx="7.5" cy="10.5" r="1" />
                                <circle cx="12" cy="7.5" r="1" />
                                <circle cx="16.5" cy="10.5" r="1" />
                            </svg>
                        </button>
                        <div
                            id="theme-menu"
                            data-ui="theme-menu"
                            data-state="closed"
                            role="menu"
                            aria-label="Themes"
                            class="hidden absolute right-0 top-full mt-2 min-w-48 bg-surface text-fg border border-ink shadow-[4px_4px_0px_0px_var(--c-shadow)] py-1 font-mono text-xs z-50"
                        >
                            {themes.map((t) => (
                                <button
                                    type="button"
                                    role="menuitemradio"
                                    aria-checked="false"
                                    data-ui="theme-option"
                                    data-theme-id={t.id}
                                    class="w-full flex items-center justify-between gap-3 px-3 py-2 text-left hover:bg-ink/10 aria-checked:text-accent cursor-pointer"
                                >
                                    <span class="flex flex-col">
                                        <span class="font-bold">{t.name}</span>
                                        {t.nameEn && (
                                            <span class="text-[10px] opacity-60">
                                                {t.nameEn}
                                            </span>
                                        )}
                                    </span>
                                    <span class="text-[10px] opacity-60 uppercase">
                                        {t.schemes.length > 1
                                            ? "L/D"
                                            : t.schemes[0] === "dark"
                                              ? "D"
                                              : "L"}
                                    </span>
                                </button>
                            ))}
                        </div>
                    )
                }

            <!-- Mode Toggle -->
            <button
                id="theme-toggle"
                data-ui="mode-toggle"
                class="w-8 h-8 flex items-center justify-center border border-current hover:bg-ink hover:text-on-ink transition-all rounded-sm cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-transparent disabled:hover:text-current"
                aria-label="Toggle theme"
            >
                <!-- Sun (visible in light mode) -->
                <svg
                    class="w-4 h-4 block dark:hidden"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line>
                    <line x1="21" y1="12" x2="23" y2="12"></line>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                </svg>
                <!-- Moon (visible in dark mode) -->
                <svg
                    class="w-4 h-4 hidden dark:block"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                    ></path>
                </svg>
            </button>
            </div>

            <!-- Mobile Hamburger -->
            <button
                id="mobile-menu-toggle"
                data-ui="menu-toggle"
                aria-expanded="false"
                aria-controls="mobile-menu"
                class="md:hidden w-8 h-8 flex items-center justify-center cursor-pointer"
                aria-label="Toggle menu"
            >
                <svg
                    class="w-5 h-5"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>
        </div>
    </div>

    <!-- Mobile Menu Overlay -->
    <div
        id="mobile-menu"
        data-ui="mobile-menu"
        data-state="closed"
        class="hidden fixed inset-0 top-16 backdrop-blur-lg z-40 md:hidden overflow-y-auto overflow-x-hidden"
    >
        <div
            class="flex flex-col items-center justify-center h-full gap-8 font-mono text-lg tracking-widest font-bold w-full px-6"
        >
            {
                navItems.map((item) => {
                    const isExternal = item.external;
                    return (
                        <a
                            href={item.path}
                            data-ui="nav-link"
                            class="hover:text-accent transition-colors text-center break-words w-full"
                            target={isExternal ? "_blank" : undefined}
                            rel={isExternal ? "noopener noreferrer" : undefined}
                        >
                            {item.name.toUpperCase()}
                        </a>
                    );
                })
            }
        </div>
    </div>
</nav>

<script>
    import {
        $themeId,
        initTheme,
        switchTheme,
        toggleTheme,
    } from "../../stores/theme";
    import { getThemeItem } from "../../lib/themes/client/runtime";
    import { typeWriter } from "../../lib/effects";

    let cleanupTypewriter: (() => void) | null = null;
    let hasPlayedIntro = false;

    function initSubtitleTypewriter() {
        const subtitle = document.getElementById("site-subtitle");
        if (!subtitle) return;

        const fullText = subtitle.dataset.text ?? "";
        // 兼容带 trailing slash 的情况
        const isHomePage =
            window.location.pathname === "/" || window.location.pathname === "";

        if (cleanupTypewriter) cleanupTypewriter();

        // 仅在首次访问首页时播放动画
        if (isHomePage && !hasPlayedIntro) {
            cleanupTypewriter = typeWriter(subtitle, fullText, {
                speed: 600,
                initialDelay: 300,
            });
            hasPlayedIntro = true;
        } else {
            // 其他页面或已播放过，直接显示完整文本
            subtitle.textContent = fullText;
        }
    }

    function initHeader() {
        // 同步主题状态
        initTheme();
        initSubtitleTypewriter();

        const toggle = document.getElementById("theme-toggle");
        const menuToggle = document.getElementById("theme-menu-toggle");
        const themeMenu = document.getElementById("theme-menu");
        const mobileToggle = document.getElementById("mobile-menu-toggle");
        const mobileMenu = document.getElementById("mobile-menu");

        toggle?.addEventListener("click", () => {
            toggleTheme();
        });

        // ── 主题菜单 ──
        const setMenuOpen = (open: boolean) => {
            if (!themeMenu || !menuToggle) return;
            themeMenu.classList.toggle("hidden", !open);
            themeMenu.dataset.state = open ? "open" : "closed";
            menuToggle.setAttribute("aria-expanded", String(open));
        };

        menuToggle?.addEventListener("click", (e) => {
            e.stopPropagation();
            setMenuOpen(themeMenu?.dataset.state !== "open");
        });

        themeMenu
            ?.querySelectorAll<HTMLElement>('[data-ui="theme-option"]')
            .forEach((option) => {
                option.addEventListener("click", () => {
                    setMenuOpen(false);
                    const id = option.dataset.themeId;
                    if (id) void switchTheme(id);
                });
            });

        const closeOnOutside = (e: MouseEvent) => {
            if (!themeMenu || themeMenu.dataset.state !== "open") return;
            if (
                e.target instanceof Node &&
                (themeMenu.contains(e.target) || menuToggle?.contains(e.target))
            )
                return;
            setMenuOpen(false);
        };
        const closeOnEscape = (e: KeyboardEvent) => {
            if (e.key === "Escape") setMenuOpen(false);
        };
        document.addEventListener("click", closeOnOutside);
        document.addEventListener("keydown", closeOnEscape);

        // 同步选中态 & 模式按钮可用性（主题只支持一种模式时锁定）
        const syncSwitcher = (themeId: string) => {
            themeMenu
                ?.querySelectorAll<HTMLElement>('[data-ui="theme-option"]')
                .forEach((option) => {
                    const checked = option.dataset.themeId === themeId;
                    option.setAttribute("aria-checked", String(checked));
                    option.dataset.state = checked ? "active" : "";
                });
            const schemes = getThemeItem(themeId)?.schemes ?? ["light", "dark"];
            const locked = schemes.length < 2;
            if (toggle instanceof HTMLButtonElement) {
                toggle.disabled = locked;
                toggle.dataset.state = locked ? "locked" : "";
                toggle.title = locked ? "This theme only supports one mode" : "";
            }
        };
        const unsubscribe = $themeId.subscribe(syncSwitcher);
        // 主题文案可能替换副标题：切换主题时停止打字机，直接显示新文案
        const unlistenCopy = $themeId.listen(() => {
            const subtitle = document.getElementById("site-subtitle");
            if (!subtitle) return;
            cleanupTypewriter?.();
            cleanupTypewriter = null;
            subtitle.textContent = subtitle.dataset.text ?? subtitle.textContent;
        });

        mobileToggle?.addEventListener("click", () => {
            const open = mobileMenu?.classList.toggle("hidden") === false;
            if (mobileMenu) mobileMenu.dataset.state = open ? "open" : "closed";
            mobileToggle.setAttribute("aria-expanded", String(open));
        });

        // Close mobile menu on link click
        mobileMenu?.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", () => {
                mobileMenu?.classList.add("hidden");
                mobileMenu.dataset.state = "closed";
            });
        });

        document.addEventListener(
            "astro:before-swap",
            () => {
                unsubscribe();
                unlistenCopy();
                document.removeEventListener("click", closeOnOutside);
                document.removeEventListener("keydown", closeOnEscape);
            },
            { once: true },
        );
    }

    // Utilize astro:page-load for View Transitions support (runs on initial load + after swap)
    document.addEventListener("astro:page-load", initHeader);
</script>
